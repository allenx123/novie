# Novie: how /usr/libexec/Xorg.wrap decides whether it may start the X server.
#
# The desktop runs as the unprivileged user novie (see /etc/inittab), so the `startx` in
# ~novie/.profile cannot open the VT or the evdev input devices by itself. xorg-server ships
# Xorg.wrap setuid root for exactly this; `console` is its own default, written out here so
# that what the desktop depends on is visible rather than implied. It lets a user start X
# only while they own the tty they are on, which agetty's autologin arranges for novie on
# tty1 and for nobody else -- there is no other way into this VM.
allowed_users=console
# With no logind session to hand the devices over, the server keeps its privileges; `auto`
# would come to the same conclusion, having found no session to ask.
needs_root_rights=yes
