# XFCE's preferred applications. Without this, the panel's Web Browser button runs
# `exo-open --launch WebBrowser`, finds nothing registered and puts up "Failed to execute
# default Web Browser. I/O error." -- even though a browser is installed.
# The values are helper names from /usr/share/xfce4/helpers.
#
# This is only the panel's idea of a browser; links opened through xdg-open or GIO follow
# /etc/xdg/mimeapps.list instead. Both name Chromium, so the desktop has one answer rather
# than two. Firefox is still installed and still in the applications menu.
WebBrowser=chromium
TerminalEmulator=xfce4-terminal
FileManager=thunar
